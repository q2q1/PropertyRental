@model MessageComposeModel
@{
    ViewData["Title"] = "Compose message";
}
<h1 class="h4 mb-3">Compose message</h1>
<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-2">
        <label class="form-label" asp-for="ReceiverId">To</label>
        <select asp-for="ReceiverId" class="form-select" asp-items="ViewBag.ReceiverOptions"></select>
        <span asp-validation-for="ReceiverId" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <label asp-for="Subject" class="form-label"></label>
        <input asp-for="Subject" class="form-control" />
        <span asp-validation-for="Subject" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Body" class="form-label"></label>
        <textarea asp-for="Body" class="form-control" rows="6"></textarea>
        <span asp-validation-for="Body" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Send</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
