@model IReadOnlyList<Building>
@{
    ViewData["Title"] = "Buildings";
}
<h1 class="h3 mb-3">Buildings</h1>
<form method="get" class="row g-2 mb-3">
    <div class="col-auto"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search" /></div>
    <div class="col-auto"><button type="submit" class="btn btn-outline-primary">Search</button></div>
    <div class="col-auto"><a asp-action="Create" class="btn btn-primary">Add building</a></div>
</form>
<table class="table table-striped">
    <thead><tr><th>Name</th><th>Address</th><th>City</th><th></th></tr></thead>
    <tbody>
    @foreach (var b in Model)
    {
        <tr>
            <td>@b.Name</td>
            <td>@b.StreetAddress</td>
            <td>@b.City</td>
            <td class="text-end">
                <a asp-action="Details" asp-route-id="@b.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                <a asp-action="Edit" asp-route-id="@b.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                <a asp-action="Delete" asp-route-id="@b.Id" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
