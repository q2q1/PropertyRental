@model Building
@{
    ViewData["Title"] = Model.Name;
}
<h1 class="h4">@Model.Name</h1>
<p class="text-secondary">@Model.StreetAddress, @Model.City @Model.PostalCode</p>
<p class="small">Property manager: @(Model.PropertyManager?.Email ?? "—")</p>
<h2 class="h6 mt-4">Apartments</h2>
<ul class="list-group">
@foreach (var a in Model.Apartments.OrderBy(x => x.UnitNumber))
{
    <li class="list-group-item d-flex justify-content-between align-items-center">
        <span>Unit @a.UnitNumber — @a.Bedrooms bed / @a.Bathrooms bath — @a.MonthlyRent.ToString("C") — @a.Status</span>
        <a asp-controller="OwnerApartments" asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
    </li>
}
</ul>
<div class="mt-3 d-flex flex-wrap gap-2">
    <a asp-controller="OwnerApartments" asp-action="Index" asp-route-buildingId="@Model.Id" class="btn btn-sm btn-outline-primary">View all units in this building</a>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">Edit building</a>
    <a asp-action="Index" class="btn btn-link">Back to my buildings</a>
</div>
