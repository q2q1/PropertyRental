@model IReadOnlyList<ApplicationUser>
@{
    ViewData["Title"] = "Tenants";
}
<h1 class="h3 mb-3">Tenant accounts</h1>
<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
    </div>
</form>
<table class="table table-striped table-sm">
    <thead><tr><th>Name</th><th>Email</th><th></th></tr></thead>
    <tbody>
    @foreach (var u in Model)
    {
        <tr>
            <td>@u.FirstName @u.LastName</td>
            <td>@u.Email</td>
            <td class="text-end">
                @if (User.IsInRole("PropertyManager"))
                {
                    <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@u.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
