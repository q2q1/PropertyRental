@model IReadOnlyList<Message>
@{
    ViewData["Title"] = "Messages";
    var inbox = ViewBag.Inbox as IReadOnlyList<Message> ?? Array.Empty<Message>();
    var sent = ViewBag.Sent as IReadOnlyList<Message> ?? Array.Empty<Message>();
}
<h1 class="h3 mb-2">Messages</h1>
<p><a asp-action="Create" class="btn btn-primary btn-sm">Compose</a></p>

@if (Model.Count == 0)
{
    <p class="text-secondary">No messages yet. Use <strong>Compose</strong> to send one.</p>
}
else
{
    <h2 class="h5 mt-4 mb-2">Inbox</h2>
    @if (inbox.Count == 0)
    {
        <p class="small text-muted">No inbox messages.</p>
    }
    <div class="list-group mb-4">
        @foreach (var m in inbox)
        {
            <div class="list-group-item">
                <div class="d-flex justify-content-between">
                    <strong>@m.Subject</strong>
                    <small class="text-muted">@m.SentUtc.ToString("g") UTC</small>
                </div>
                <div class="small">From: @m.Sender?.Email</div>
                <p class="mb-1 mt-2">@m.Body</p>
                @if (m.ReceiverId == User.FindFirstValue(ClaimTypes.NameIdentifier) && !m.IsRead)
                {
                    <form asp-action="MarkRead" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@m.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Mark read</button>
                    </form>
                }
            </div>
        }
    </div>

    <h2 class="h5 mb-2">Sent</h2>
    @if (sent.Count == 0)
    {
        <p class="small text-muted">No sent messages.</p>
    }
    <div class="list-group">
        @foreach (var m in sent)
        {
            <div class="list-group-item">
                <div class="d-flex justify-content-between">
                    <strong>@m.Subject</strong>
                    <small class="text-muted">@m.SentUtc.ToString("g") UTC</small>
                </div>
                <div class="small">To: @m.Receiver?.Email</div>
                <p class="mb-1 mt-2">@m.Body</p>
            </div>
        }
    </div>
}
